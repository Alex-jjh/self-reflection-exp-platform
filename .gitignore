.venv/
__pycache__/
*.pyc
.DS_Store

# Participant data — NEVER tracked. Real people, consent-scoped.
sessions/

# NOTE: pilot-transcripts/ is deliberately NOT ignored. Those are synthetic:
# authored frozen scripts (frozen-scripts/) replayed against condition
# prompts — no human subject, no consent scope. They are the instrument's
# validation evidence and the provenance for the v1-freeze, so they belong
# in the repo alongside the prompts that produced them.

screening/items/
refsrc
.bedrock_key

# Synthetic matrix (SYN) runs in model-comparison/: tracked (research repo
# D-020; no human subject; ~4 MB text JSON). Only runtime locks, the blinding
# key and the auto-coder's private_routing/ folders (below; each also carries
# its own .gitignore) are excluded. Quarantined/incident runs stay tracked
# with their INCIDENT.md so the record is auditable.
model-comparison/**/.run.lock
.openai_key
.xjtlu_key
.gemini_key
# derived from the md — regenerate with pandoc, do not track
protocol/SESSION_PROTOCOL.pdf

# local streamlit runtime artifacts
.streamlit/
streamlit.log
# derived from the md — regenerate with pandoc, do not track
protocol/TOPIC_MAP.pdf
# Blinding key stays local until the 12-unit human anchor is coded
# (repo is public; tracking it would unblind B004/B022/B040/B047). What happens
# to it afterwards is open (research repo STATUS.md, Decisions pending). The raw
# transcripts are tracked and named by model and condition, and the auto-code
# records carry routing metadata, so the anchor coder must not open them first
# (matrix-pilot/README.md, "Before coding the human anchor").
model-comparison/**/private_mapping.json
model-comparison/**/private_routing/
